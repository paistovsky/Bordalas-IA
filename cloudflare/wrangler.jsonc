{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bordalas-ia-dashboard",
  "main": "worker.js",
  "compatibility_date": "2026-08-11",
  "workers_dev": true,

  "assets": {
    "directory": "../dashboard",
    "binding": "ASSETS",
    "run_worker_first": [
      "/data/status.json"
    ]
  },

  "kv_namespaces": [
    {
      "binding": "BORDALAS_STATUS",
      "id": "dbb7542f31b34d8ab0590bf774538b21"
    }
  ]
}
